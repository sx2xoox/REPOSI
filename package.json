{
  "name": "lanternkeeper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "등불지기 — 꺼진 도시의 지하로 내려가는 로그라이크 액션 (TypeScript + Canvas)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "galmuri": "^2.40.3",
    "peer": "^1.0.2",
    "playwright": "1.56",
    "typescript": "~5.9",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "peerjs": "^1.5.5"
  }
}
