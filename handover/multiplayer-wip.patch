+      if (!p) continue;
+      const col = slotColor(p.slot);
+      const mine = p === w.local;
+      if (tag.onScreen) {
+        if (!mine) r.uiText(keeperName(p), tag.x, tag.y - 12, { size: 10, font: 'small', align: 'center', color: col, outline: C.ink, alpha: A });
