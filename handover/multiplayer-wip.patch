+    const r = runScenario({ name: 'solo', seed: 'COOP-SOLO', character: 'ria', floors: [1], exploreSteps: 600, bossSteps: 600, giftsPerFloor: 3, maxSteps: 1500, cycle: true, extraEnemies: 1 }, BASE_VARIANT);
