+    for (let i = 0; i < total; i++) {
+      const hx = x + 32 + i * (pip + 1);
+      const hy = y + 18;
+      const isRed = i < p.maxRed;
+      const filled = isRed ? i < p.red : i - p.maxRed < p.soul;
