+// TEMPORARY (not committed): records / compares single-player hash sequences.
+import './headless';
+import { it, expect } from 'vitest';
+import { BASE_VARIANT, runScenario, firstMismatch, type Scenario } from './detsim';
+import { existsSync, readFileSync, writeFileSync } from 'node:fs';
+
+const FILE = process.env.SP_BASELINE ?? '/tmp/claude-0/-home-user-REPOSI/5b6d1b7f-a03d-5f09-9d18-90f35456395e/scratchpad/coop/sp-baseline.json';
+const SCEN: Scenario[] = [
+  { name: 'ria', seed: 'DET-RIA-1', character: 'ria', floors: [1, 2, 3, 4, 5], exploreSteps: 700, bossSteps: 1500, giftsPerFloor: 6, maxSteps: 14000, cycle: true, extraEnemies: 2 },
+  { name: 'niel', seed: 'DET-NIEL-4', character: 'niel', floors: [1], exploreSteps: 1500, bossSteps: 1500, giftsPerFloor: 4, maxSteps: 3600, cycle: true, extraEnemies: 2 },
+  { name: 'serin', seed: 'DET-SERIN-2', character: 'serin', floors: [2, 3], exploreSteps: 1300, bossSteps: 1500, giftsPerFloor: 5, maxSteps: 7000, cycle: true, extraEnemies: 2 },
+  { name: 'bern', seed: 'DET-BERN-3', character: 'bern', floors: [4, 5], exploreSteps: 1200, bossSteps: 1500, giftsPerFloor: 6, maxSteps: 7000, cycle: true, extraEnemies: 3 },
+];
+
+it('sp baseline', () => {
+  const out: Record<string, number[]> = {};
+  for (const sc of SCEN) out[sc.name] = runScenario(sc, BASE_VARIANT).hashes;
+  if (process.env.SP_RECORD || !existsSync(FILE)) {
+    writeFileSync(FILE, JSON.stringify(out));
+    console.log('recorded', Object.fromEntries(Object.entries(out).map(([k, v]) => [k, v.length])));
+    return;
+  }
+  const base = JSON.parse(readFileSync(FILE, 'utf8')) as Record<string, number[]>;
+  for (const sc of SCEN) {
+    const k = firstMismatch(base[sc.name], out[sc.name]);
+    console.log(sc.name, 'len', base[sc.name].length, out[sc.name].length, 'first mismatch', k);
+    expect(k, sc.name).toBe(-1);
+  }
+}, 600_000);
